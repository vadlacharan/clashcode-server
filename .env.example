# PostgreSQL (Payload) — credentials must match docker-compose.yml
DATABASE_URL=postgres://clashcode:clashcode@127.0.0.1:5432/clashcode

# Secret used to sign Payload auth tokens (change this)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Redis (matchmaking, queues, rate limiting, realtime pub/sub)
REDIS_URL=redis://127.0.0.1:6379

# Self-hosted Piston code execution engine
PISTON_URL=http://127.0.0.1:2000

# URLs used for CORS / socket origin allowlists
SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
