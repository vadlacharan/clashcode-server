# Backend production environment for the Azure VM deployment.
# Copy to `.env.production` and fill in real values.

# --- Supabase Postgres -------------------------------------------------------
# Supabase Dashboard → Project Settings → Database → Connection string →
# "Session pooler" (port 5432). IMPORTANT: use Session mode, NOT the
# transaction pooler on port 6543 — Payload/Drizzle relies on prepared
# statements, which transaction pooling does not support.
# Keep `sslmode=require` — Supabase rejects unencrypted connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-64-char-random-hex-string

# --- URLs (drive CORS, CSRF and Socket.IO allowlists) --------------------------
SERVER_URL=https://api.yourdomain.com
# The Vercel domain of the frontend (exact origin, no trailing slash).
# e.g. https://syntax-school.vercel.app or your custom domain attached to Vercel.
FRONTEND_URL=https://app.yourdomain.com

# PISTON_URL, REDIS_URL and JUDGE_PROVIDER are set in docker-compose.prod.yml
# (they point at the in-network piston/redis containers).
